---
// Site layout: bold grotesk + mono, full-bleed bands, light/dark toggle.
import '../styles/palette.css';
import { CONTACT_EMAIL, ISSUES_URL, NAV, isCurrent, url } from '../lib/site.js';

const { title, heading, wide = false } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ? `${title} · MARVEL Database` : 'MARVEL Database'}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />
  <script is:inline>
    // Apply a saved theme choice before first paint; otherwise follow the system.
    try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site">
    <nav aria-label="Main">
      <a class="brand" href={url('/')}><span class="brand-mark" aria-hidden="true"></span>MARVEL<span class="brand-db">db</span></a>
      <ul>
        {NAV.map(([p, label]) => (
          <li><a href={url(p)} aria-current={isCurrent(p, path) ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
      <button type="button" class="theme" data-theme-toggle hidden aria-label="Switch to light mode">
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1" /></svg>
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z" /></svg>
      </button>
    </nav>
  </header>
  <main id="main" class={wide ? 'wide' : 'column'}>
    {heading && <h1 class="page-title">{heading}</h1>}
    <slot />
  </main>
  <footer class="site">
    <div class="foot">
      <div>
        <p>Department of Physics &amp; Astronomy, University College London (UCL).</p>
        <p>Found a data error? <a href={ISSUES_URL}>Open a GitHub issue</a>. Anything else: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
      </div>
      <a class="exomol" href="https://www.exomol.com/" aria-label="ExoMol">
        <!-- ExoMol's mark, redrawn from the exomol.com favicon: a star with a transiting planet. -->
        <svg viewBox="0 0 32 32" aria-hidden="true">
          <circle cx="16" cy="16" r="14" fill="#ffee00" stroke="#e8000b" stroke-width="2" />
          <circle cx="10.5" cy="13" r="3.8" fill="#000" />
        </svg>
        <span>ExoMol</span>
      </a>
    </div>
  </footer>
</body>
</html>

<script>
  // Light/dark toggle: flips the effective theme and remembers the choice.
  const btn = document.querySelector('[data-theme-toggle]');
  const root = document.documentElement;
  const dark = () => (root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')) === 'dark';
  const label = () => btn.setAttribute('aria-label', dark() ? 'Switch to light mode' : 'Switch to dark mode');
  btn.hidden = false;
  label();
  btn.addEventListener('click', () => {
    root.dataset.theme = dark() ? 'light' : 'dark';
    try { localStorage.setItem('theme', root.dataset.theme); } catch {}
    label();
  });
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', label);
</script>

<style is:global>
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0; background: var(--bg); color: var(--fg);
    font: 16px/1.6 "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
    display: flex; flex-direction: column; min-height: 100vh;
  }
  main { flex: 1; width: 100%; }
  .column { max-width: 50rem; margin: 0 auto; padding: 2rem 16px 4rem; }
  .wide { padding-bottom: 4rem; }
  .inner { max-width: 72rem; margin: 0 auto; padding: 0 16px; }
  a { color: var(--link); text-underline-offset: 0.18em; }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-radius: 4px; }
  .skip { position: absolute; left: -999px; top: 0.5rem; background: var(--bg); color: var(--fg); padding: 0.5rem 1rem; z-index: 10; }
  .skip:focus { left: 0.5rem; }

  h1, h2, h3 { line-height: 1.15; letter-spacing: -0.01em; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; margin: 0 0 1.25rem; }
  h2 { font-size: 1.5rem; font-weight: 650; margin: 2.5rem 0 0.75rem; }
  h3 { font-size: 1.05rem; font-weight: 600; margin: 1.75rem 0 0.5rem; }
  p { margin: 0 0 1rem; }
  ul, ol { padding-left: 1.25rem; margin: 0 0 1rem; }
  li { margin-bottom: 0.45rem; }
  code, pre, .mono { font-family: "IBM Plex Mono", ui-monospace, Menlo, monospace; }
  code { font-size: 0.875em; background: var(--surface); padding: 0.1em 0.35em; border-radius: 4px; }
  pre { background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--accent-2); border-radius: 8px; padding: 1rem 1.1rem; overflow-x: auto; font-size: 0.85rem; line-height: 1.55; }
  pre code { background: none; padding: 0; font-size: inherit; }
  .table-scroll { overflow-x: auto; margin: 0 0 1rem; }
  table { width: 100%; border-collapse: collapse; font-size: 0.9375rem; }
  th, td { text-align: left; vertical-align: top; padding: 0.6rem 0.9rem 0.6rem 0; border-bottom: 1px solid var(--line); }
  th { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); font-weight: 600; }
  td code { white-space: nowrap; }
  .muted { color: var(--muted); }
  .method-papers { padding-left: 1.4rem; }
  .method-papers li { margin-bottom: 0.7rem; }

  .chip { display: inline-block; font: 500 0.78rem/1.2 "IBM Plex Mono", monospace; padding: 0.25rem 0.55rem; border-radius: 999px; background: var(--surface-2); color: var(--fg); white-space: nowrap; }
  .num { font-family: "IBM Plex Mono", monospace; font-variant-numeric: tabular-nums; }
  .eyebrow { font: 500 0.75rem/1 "IBM Plex Mono", monospace; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin: 0 0 0.6rem; }

  /* Page colours, captured before any band re-scopes them (.unband restores). */
  :root { --page-bg: var(--bg); --page-fg: var(--fg); --page-muted: var(--muted); --page-line: var(--line); --page-surface-2: var(--surface-2); --page-link: var(--link); }
  .unband { --bg: var(--page-bg); --fg: var(--page-fg); --muted: var(--page-muted); --line: var(--page-line); --surface-2: var(--page-surface-2); --link: var(--page-link); background: var(--bg); color: var(--fg); }

  /* A band re-scopes the tokens, so charts and text inside read on --band. */
  .band {
    --bg: var(--band); --fg: var(--on-band); --muted: var(--band-muted); --link: var(--on-band);
    --seq: var(--on-band); --surface: color-mix(in srgb, var(--on-band) 10%, transparent);
    --surface-2: color-mix(in srgb, var(--on-band) 14%, transparent);
    --line: color-mix(in srgb, var(--on-band) 22%, transparent);
    background: var(--band); color: var(--on-band);
  }
</style>

<style>
  header.site { border-bottom: 1px solid var(--line); background: var(--bg); position: sticky; top: 0; z-index: 5; }
  nav { max-width: 72rem; margin: 0 auto; padding: 0.7rem 16px; display: flex; align-items: center; gap: 0.5rem 1.5rem; flex-wrap: wrap; }
  .brand { font-weight: 700; font-size: 1.15rem; color: var(--fg); text-decoration: none; display: flex; align-items: center; gap: 0.5rem; margin-right: auto; letter-spacing: -0.01em; }
  .brand-db { font: 500 0.8rem "IBM Plex Mono", monospace; color: var(--accent); margin-left: 0.15rem; align-self: flex-start; }
  /* Spectral lines in the UCL brand colours: purple and bright blue. */
  .brand-mark { width: 1.1rem; height: 1.1rem; border-radius: 3px; background: repeating-linear-gradient(90deg, var(--accent) 0 2px, transparent 2px 4px, var(--accent-2) 4px 5px, transparent 5px 8px); }
  nav ul { list-style: none; display: flex; flex-wrap: wrap; gap: 0.25rem 1.1rem; margin: 0; padding: 0; }
  nav li { margin: 0; }
  nav ul a { color: var(--muted); text-decoration: none; font-weight: 500; padding: 0.3rem 0; border-bottom: 2px solid transparent; }
  nav ul a:hover { color: var(--fg); }
  nav ul a[aria-current="page"] { color: var(--fg); border-bottom-color: var(--accent-2); }
  .theme { display: inline-grid; place-items: center; width: 2.25rem; height: 2.25rem; border: 1px solid var(--line); border-radius: 999px; background: transparent; color: var(--fg); cursor: pointer; padding: 0; }
  .theme:hover { background: var(--surface-2); }
  .theme svg { width: 1.1rem; height: 1.1rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .theme .i-moon { fill: currentColor; stroke: none; }
  /* Show the icon of the mode you would switch to. */
  .theme .i-sun { display: none; }
  :global(:root[data-theme="dark"]) .theme .i-sun { display: block; }
  :global(:root[data-theme="dark"]) .theme .i-moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme .i-sun { display: block; }
    :global(:root:not([data-theme="light"])) .theme .i-moon { display: none; }
  }
  footer.site { border-top: 1px solid var(--line); background: var(--surface); color: var(--muted); font-size: 0.875rem; }
  .foot { max-width: 72rem; margin: 0 auto; padding: 1.5rem 16px 2rem; display: flex; flex-wrap: wrap; gap: 1rem 2rem; align-items: center; justify-content: space-between; }
  .exomol { display: inline-flex; align-items: center; gap: 0.55rem; color: var(--fg); text-decoration: none; font-weight: 700; font-size: 1.15rem; letter-spacing: -0.01em; }
  .exomol svg { width: 2rem; height: 2rem; }
  .exomol:hover span { text-decoration: underline; }
  footer.site p { margin: 0 0 0.4rem; }
</style>
