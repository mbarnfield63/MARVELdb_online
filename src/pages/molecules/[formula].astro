---
import Layout from '../../layouts/Layout.astro';
import LevelMap from '../../components/charts/LevelMap.astro';
import { loadSite, runFigure, formulaLevelMap } from '../../lib/data.js';
import { API, FILE_ROLES, humanSize, runLabel, url } from '../../lib/site.js';

export async function getStaticPaths() {
  const { formulas } = await loadSite();
  return formulas.map((f) => ({ params: { formula: f.slug }, props: { formula: f } }));
}

const { formula } = Astro.props;
const { pubByKey, references } = await loadSite();
const shortOf = Object.fromEntries(references.map((p) => [p.bibtex_key, p.short]));
const isos = await Promise.all(formula.isos.map(async (m) => ({
  ...m,
  runs: await Promise.all(m.runs.map(async (r) => ({ ...r, fig: await runFigure(r.id) }))),
})));
const levelMap = await formulaLevelMap(formula);
const n = (v) => (v ?? 0).toLocaleString('en');
const version = (r) => (isNaN(parseFloat(r.version)) ? 'unknown' : r.version);
---
<Layout title={formula.formula} wide>
  <section class="band head">
    <div class="inner head-grid">
      <div>
      <p class="eyebrow"><a href={url('/molecules/')}>Molecules</a> / {formula.group}</p>
      <h1>{formula.formula}</h1>
      <ul class="totals">
        <li><strong class="num">{formula.isos.length}</strong> isotopologue{formula.isos.length === 1 ? '' : 's'}</li>
        <li><strong class="num">{n(formula.nLevels)}</strong> levels</li>
        <li><strong class="num">{n(formula.nTransitions)}</strong> transitions</li>
      </ul>
      {isos.length > 1 && (
        <nav class="jump" aria-label="Isotopologues">
          {isos.map((m) => <a class="chip" href={`#${m.slug}`}>{m.isotopologue}</a>)}
        </nav>
      )}
      </div>
      {levelMap && (
        <figure class="mini unband">
          <p class="mini-title">Energy levels <span class="muted">latest run per isotopologue</span></p>
          <LevelMap fig={levelMap} label={`${formula.formula} energy levels`} />
        </figure>
      )}
    </div>
  </section>

  <div class="inner">
    {isos.map((m) => (
      <section id={m.slug} class="iso" aria-labelledby={`h-${m.slug}`}>
        <h2 id={`h-${m.slug}`}>{m.isotopologue}</h2>
        {m.runs.length === 0 ? <p class="muted">No runs loaded.</p> : (
          <div data-runs>
            {m.runs.length > 1 && (
              <div class="switch" role="group" aria-label={`MARVEL run for ${m.isotopologue}`} hidden>
                {m.runs.map((r, i) => (
                  <button type="button" data-for={r.id} aria-pressed={i === 0 ? 'true' : 'false'}>{runLabel(r)}</button>
                ))}
              </div>
            )}
            {m.runs.map((r) => (
              <article class="run" data-run={r.id} aria-label={runLabel(r)}>
                {m.runs.length > 1 && <h3 class="run-title">{runLabel(r)}</h3>}
                <div class="meta">
                  {r.publication && (
                    <a class="paper" href={url(`/references/#${r.publication}`)} set:html={shortOf[r.publication] ?? r.publication}
                      title={pubByKey[r.publication]?.title?.replace(/[{}$]/g, '')} />
                  )}
                  {r.description && <span class="muted">{r.description}</span>}
                </div>
                <ul class="files">
                  {FILE_ROLES.map(([role, label]) => (
                    <li>
                      {r.files[role] != null
                        ? <a class="file" href={`${API}/runs/${r.id}/files/${role}`}><span>{label}</span><span class="num size">{humanSize(r.files[role])}</span></a>
                        : <span class="file off"><span>{label}</span><span class="size">not available</span></span>}
                    </li>
                  ))}
                </ul>
                <ul class="chips">
                  <li><span>version</span><strong class="num">{version(r)}</strong></li>
                  {r.n_levels != null && <li><span>levels</span><strong class="num">{n(r.n_levels)}</strong></li>}
                  {r.n_transitions != null && <li><span>transitions</span><strong class="num">{n(r.n_transitions)}</strong></li>}
                  {r.fig.sources > 0 && <li><span>sources</span><strong class="num">{n(r.fig.sources)}</strong></li>}
                  {r.fig.nRemoved > 0 && <li><span>removed</span><strong class="num">{n(r.fig.nRemoved)}</strong></li>}
                </ul>
              </article>
            ))}
          </div>
        )}
      </section>
    ))}
    <p class="muted hint">Files open as plain text in the browser. Right-click a link and choose "Save link as" to download.</p>
  </div>
</Layout>

<script>
  // Progressive enhancement: without JS every run is listed; with it, the
  // pills switch between runs and only the selected one shows.
  for (const box of document.querySelectorAll('[data-runs]')) {
    const sw = box.querySelector('.switch');
    if (!sw) continue;
    const runs = [...box.querySelectorAll('[data-run]')];
    const show = (id) => {
      for (const r of runs) r.hidden = r.dataset.run !== id;
      for (const b of sw.querySelectorAll('button')) b.setAttribute('aria-pressed', String(b.dataset.for === id));
    };
    sw.hidden = false;
    box.classList.add('js');
    sw.addEventListener('click', (e) => { const b = e.target.closest('button'); if (b) show(b.dataset.for); });
    show(runs[0].dataset.run);
  }
</script>

<style>
  .head { padding: 2.25rem 0 2rem; }
  .head-grid { display: grid; grid-template-columns: 1fr minmax(16rem, 22rem); gap: 1.5rem 2.5rem; align-items: center; }
  @media (max-width: 48rem) { .head-grid { grid-template-columns: 1fr; } }
  .mini { margin: 0; border-radius: 12px; padding: 0.8rem 0.9rem 0.7rem; }
  .mini-title { font-weight: 600; font-size: 0.8125rem; margin: 0 0 0.4rem; }
  .mini-title .muted { font-weight: 400; margin-left: 0.3rem; }
  .mini :global(.legend) { font-size: 0.75rem; gap: 0.15rem 0.75rem; }
  .head .eyebrow a { color: inherit; }
  .head h1 { font-size: clamp(3rem, 9vw, 5.5rem); margin-bottom: 0.75rem; letter-spacing: -0.03em; }
  .totals { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1.75rem; color: var(--muted); }
  .totals li { margin: 0; }
  .totals strong { color: var(--fg); font-size: 1.35rem; font-weight: 500; margin-right: 0.3rem; }
  .jump { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1.25rem; }
  .jump .chip { text-decoration: none; }

  .iso { padding-top: 0.5rem; border-bottom: 1px solid var(--line); padding-bottom: 2rem; scroll-margin-top: 4rem; }
  .iso h2 { font-size: 1.9rem; margin-top: 2rem; }
  .switch { display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; border-radius: 12px; background: var(--surface-2); margin-bottom: 1rem; max-width: 100%; }
  .switch button { font: 500 0.8125rem/1.3 "IBM Plex Sans", sans-serif; border: 0; background: transparent; color: var(--muted); padding: 0.45rem 0.8rem; border-radius: 9px; cursor: pointer; text-align: left; }
  .switch button[aria-pressed="true"] { background: var(--bg); color: var(--fg); box-shadow: 0 1px 2px color-mix(in srgb, var(--fg) 18%, transparent); }
  .switch button:hover { color: var(--fg); }
  .js .run-title { display: none; }
  .run + .run { margin-top: 2rem; }
  .js .run + .run { margin-top: 0; }
  .run-title { font-size: 1rem; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; margin-bottom: 0.9rem; }
  .paper { font-weight: 600; }
  .chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chips li { margin: 0; display: flex; flex-direction: column; padding: 0.45rem 0.8rem; border: 1px solid var(--line); border-radius: 10px; min-width: 6rem; }
  .chips span { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .chips strong { font-size: 1.2rem; font-weight: 500; }
  .files { list-style: none; padding: 0; margin: 0 0 1rem; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .files li { margin: 0; }
  .file { display: inline-flex; gap: 0.7rem; align-items: baseline; padding: 0.55rem 0.95rem; border-radius: 999px; border: 1px solid var(--accent-2); color: var(--fg); text-decoration: none; font-weight: 500; }
  .file:hover { background: var(--surface-2); }
  .file .size { font-size: 0.8125rem; color: var(--muted); font-weight: 400; }
  .file.off { border-style: dashed; border-color: var(--line); color: var(--muted); }
  .hint { margin-top: 2rem; font-size: 0.875rem; }
</style>
