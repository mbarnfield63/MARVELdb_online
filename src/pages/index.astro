---
import Base from '../layouts/Base.astro';
import { ISSUES_URL, MARVEL_URL, moleculesWithRuns, url } from '../lib/site.js';

const mols = await moleculesWithRuns();
const runs = mols.flatMap((m) => m.runs);
const stats = [
  ['molecules', new Set(mols.map((m) => m.formula)).size],
  ['isotopologues', mols.length],
  ['runs', runs.length],
  ['energy levels', runs.reduce((n, r) => n + (r.n_levels ?? 0), 0)],
];

const methodPapers = [
  ['T. Furtenbacher, A. G. Császár, J. Tennyson (2007). MARVEL: measured active rotational–vibrational energy levels. J. Mol. Spectrosc. 245, 115–125.', '10.1016/j.jms.2007.07.005'],
  ['T. Furtenbacher, A. G. Császár (2012). MARVEL: measured active rotational–vibrational energy levels. II. Algorithmic improvements. J. Quant. Spectrosc. Radiat. Transf. 113, 929–935.', '10.1016/j.jqsrt.2012.01.005'],
  ['R. Tóbiás, T. Furtenbacher, J. Tennyson, A. G. Császár (2019). Accurate empirical rovibrational energies and transitions of H₂¹⁶O. Phys. Chem. Chem. Phys. 21, 3473–3495.', '10.1039/C8CP05169K'],
];
---
<Base>
  <h1>MARVEL Database</h1>
  <p>
    MARVEL (Measured Active Rotational–Vibrational Energy Levels) turns measured spectroscopic transitions
    into empirical energy levels with uncertainties. This database serves to collate published MARVEL runs
    across molecules, isotopologues and algorithm versions, each traced back to its paper.
  </p>
  <p>
    To run MARVEL online, please <a href={MARVEL_URL}>click here</a>.<br />
    To view and download the MARVEL source code, please visit the <a href="https://github.com/FurtEd/MARVEL">MARVEL GitHub repository</a>.
  </p>
  <h2>Currently in Database</h2>
  <ul class="stats">
    {stats.map(([label, n]) => <li><strong>{n.toLocaleString('en')}</strong> {label}</li>)}
  </ul>

  <h2>Navigating the site</h2>
  <p>
    <a href={url('/molecules/')}>Molecules</a> groups the data into diatomics, triatomics and polyatomics. Pick a molecule
    to see its isotopologues. Each isotopologue has a run menu, newest first, with the latest run of each MARVEL version
    marked. Under the menu are the run's paper, its level and transition counts, and links to its energy-levels,
    transitions and segment files. The files open as plain text; right-click to save them.
  </p>
  <p><a href={url('/references/')}>References</a> lists the paper behind every run.</p>
  <p>
    <a href={url('/api/')}>API</a> explains how to query the data directly: filtering levels by quantum numbers, paging
    through transitions, and downloading files from scripts. The site itself has no search or filtering, so this is where
    to go for anything beyond whole files.
  </p>
  <p><a href={url('/submit/')}>Submitting data</a> covers how to send a MARVEL dataset for inclusion.</p>

  <h2>Reporting errors</h2>
  <p>
    If you find a problem in data that is already here, such as a wrong level, a missing file or a bad citation, please
    <a href={ISSUES_URL}>open a GitHub issue</a> with the molecule, the run and what looks wrong.
  </p>

  <h2 id="cite">Citing MARVEL</h2>
  <p>If you use MARVEL data, please cite the method papers:</p>
  <ul class="cites">
    {methodPapers.map(([text, doi]) => <li>{text} <a href={`https://doi.org/${doi}`}>doi:{doi}</a></li>)}
  </ul>
  <p>Cite the paper for each dataset as well; see <a href={url('/references/')}>References</a>.</p>
</Base>

<style>
  .stats { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; margin: 0.5rem 0 1.25rem; }
  .stats strong { font-size: 1.5rem; font-variant-numeric: tabular-nums; }
  .cites li { margin-bottom: 0.4rem; }
</style>
