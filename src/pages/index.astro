---
import Layout from '../layouts/Layout.astro';
import Coverage from '../components/charts/Coverage.astro';
import Intro from '../components/content/Intro.astro';
import SiteGuide from '../components/content/SiteGuide.astro';
import ReportErrors from '../components/content/ReportErrors.astro';
import CiteMarvel from '../components/content/CiteMarvel.astro';
import { loadSite, coverageByMolecule } from '../lib/data.js';
import { url } from '../lib/site.js';

const { stats: allStats, lastLoaded } = await loadSite();
const stats = allStats.filter((s) => s.key !== 'runs');
const overview = await coverageByMolecule();
---
<Layout wide>
  <section class="band hero" aria-labelledby="hero-title">
    <div class="inner">
      <p class="eyebrow">Measured Active Rotational–Vibrational Energy Levels</p>
      <h1 id="hero-title">MARVEL<sup>db</sup></h1>
      <ul class="stats">
        {stats.map((s) => <li><strong class="num">{s.n.toLocaleString('en')}</strong><span>{s.label}</span></li>)}
      </ul>

      <figure class="spectrogram">
        <figcaption>
          <span>Spectral coverage of the input transitions: per molecule, its most recently published isotopologue</span>
          <span class="num">cm⁻¹, log scale</span>
        </figcaption>
        <div class="rows">
          {overview.rows.map(({ formula, mol, run }) => (
            <a class="row" href={url(`/molecules/${formula.slug}/#${mol.slug}`)}>
              <span class="label"><strong>{formula.formula}</strong> <span class="num iso">{mol.isotopologue}</span></span>
              <span class="count num">{run.n_transitions.toLocaleString('en')}</span>
            </a>
          ))}
        </div>
        <div class="strips">
          {overview.rows.map(({ mol, coverage }) => (
            <Coverage coverage={coverage} mode="strip" label={`${mol.isotopologue} spectral coverage`} />
          ))}
          <Coverage mode="axis" />
        </div>
      </figure>
      <p class="updated num">Last updated {lastLoaded}</p>
    </div>
  </section>

  <div class="inner body">
    <section class="lead">
      <h2>About</h2>
      <Intro />
      <p><a class="cta" href={url('/molecules/')}>Browse the molecules →</a></p>
    </section>
    <section>
      <h2>Navigating the site</h2>
      <SiteGuide />
    </section>
    <section>
      <h2>Reporting errors</h2>
      <ReportErrors />
    </section>
    <section id="cite">
      <h2>Citing MARVEL</h2>
      <CiteMarvel />
    </section>
  </div>
</Layout>

<style>
  .hero { padding: clamp(2.5rem, 6vw, 4.5rem) 0 2.5rem; }
  .hero h1 { font-size: clamp(3rem, 9vw, 5.5rem); letter-spacing: -0.03em; margin-bottom: 2rem; }
  .hero h1 sup { font: 500 0.36em/1 "IBM Plex Mono", monospace; letter-spacing: 0; color: var(--muted); vertical-align: super; margin-left: 0.08em; }
  /* Each counter fits an 8-digit count ("99,999,999") on one line. */
  .stats { list-style: none; padding: 0; margin: 0 0 2.5rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12.5rem), 1fr)); gap: 1.25rem 1.25rem; }
  .stats li { margin: 0; border-top: 1px solid var(--line); padding-top: 0.6rem; display: flex; flex-direction: column; }
  .stats strong { font-size: clamp(1.6rem, 3.2vw, 2rem); font-weight: 500; line-height: 1.1; white-space: nowrap; }
  .stats span { color: var(--muted); font-size: 0.875rem; }

  .spectrogram { margin: 0; display: grid; grid-template-columns: minmax(9rem, max-content) 1fr; column-gap: 1rem; row-gap: 0; }
  .spectrogram figcaption { grid-column: 1 / -1; display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; font-size: 0.8125rem; color: var(--muted); margin-bottom: 0.75rem; }
  .rows, .strips { display: flex; flex-direction: column; gap: 6px; --strip-h: 22px; }
  .row { height: 22px; display: flex; justify-content: space-between; gap: 0.75rem; align-items: center; font-size: 0.75rem; color: var(--fg); text-decoration: none; }
  .row:hover .label { text-decoration: underline; }
  .row .count { color: var(--muted); }
  .row .label strong { font-weight: 600; font-size: 0.875rem; margin-right: 0.35rem; }
  .row .iso { color: var(--muted); }
  .strips :global(.axis) { margin-top: 4px; }
  .updated { margin: 1.5rem 0 0; font-size: 0.75rem; color: var(--muted); }

  .body { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr)); gap: 0 3rem; padding-top: 1rem; }
  .body section { max-width: 40rem; }
  .cta { display: inline-block; font-weight: 600; text-decoration: none; background: var(--band); color: var(--on-band); border: 1px solid var(--accent-2); padding: 0.6rem 1.1rem; border-radius: 999px; }
  .cta:hover { filter: brightness(1.1); }

  @media (max-width: 34rem) {
    .spectrogram { grid-template-columns: 7.5rem 1fr; }
    .row .count { display: none; }
  }
</style>
